{
  "name": "webpresa-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevDataStack --profile webpresa-dev --context env=dev",
    "deploy:dev": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevDataStack --profile webpresa-dev --context env=dev",
    "diff:screenshot": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevScreenshotStack --profile webpresa-dev --context env=dev",
    "deploy:screenshot": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevScreenshotStack --profile webpresa-dev --context env=dev",
    "diff:scan-workflow": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevScanWorkflowStack --profile webpresa-dev --context env=dev",
    "deploy:scan-workflow": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevScanWorkflowStack --profile webpresa-dev --context env=dev",
    "diff:postcard-render-repo": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevPostcardRenderRepositoryStack --profile webpresa-dev --context env=dev",
    "deploy:postcard-render-repo": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevPostcardRenderRepositoryStack --profile webpresa-dev --context env=dev",
    "diff:postcard-render": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevPostcardRenderStack --profile webpresa-dev --context env=dev",
    "deploy:postcard-render": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevPostcardRenderStack --profile webpresa-dev --context env=dev",
    "diff:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk diff WebpresaProdDataStack --profile webpresa-prod --context env=prod",
    "deploy:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk deploy WebpresaProdDataStack --profile webpresa-prod --context env=prod",
    "diff:screenshot:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk diff WebpresaProdScreenshotStack --profile webpresa-prod --context env=prod",
    "deploy:screenshot:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk deploy WebpresaProdScreenshotStack --profile webpresa-prod --context env=prod",
    "diff:scan-workflow:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk diff WebpresaProdScanWorkflowStack --profile webpresa-prod --context env=prod",
    "deploy:scan-workflow:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk deploy WebpresaProdScanWorkflowStack --profile webpresa-prod --context env=prod",
    "diff:postcard-render-repo:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk diff WebpresaProdPostcardRenderRepositoryStack --profile webpresa-prod --context env=prod",
    "deploy:postcard-render-repo:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk deploy WebpresaProdPostcardRenderRepositoryStack --profile webpresa-prod --context env=prod",
    "diff:postcard-render:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk diff WebpresaProdPostcardRenderStack --profile webpresa-prod --context env=prod",
    "deploy:postcard-render:prod": "WEBPRESA_APP_BASE_URL=https://webpresa.com cdk deploy WebpresaProdPostcardRenderStack --profile webpresa-prod --context env=prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.262.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
