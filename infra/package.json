{
  "name": "webpresa-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff WebpresaDevDataStack --profile webpresa",
    "deploy:dev": "cdk deploy WebpresaDevDataStack --profile webpresa",
    "diff:screenshot": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevScreenshotStack --profile webpresa",
    "deploy:screenshot": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevScreenshotStack --profile webpresa",
    "diff:scan-workflow": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevScanWorkflowStack --profile webpresa",
    "deploy:scan-workflow": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevScanWorkflowStack --profile webpresa",
    "diff:postcard-render-repo": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevPostcardRenderRepositoryStack --profile webpresa",
    "deploy:postcard-render-repo": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevPostcardRenderRepositoryStack --profile webpresa",
    "diff:postcard-render": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk diff WebpresaDevPostcardRenderStack --profile webpresa",
    "deploy:postcard-render": "WEBPRESA_APP_BASE_URL=https://webpresa-git-dev-andrew-mudges-projects.vercel.app cdk deploy WebpresaDevPostcardRenderStack --profile webpresa",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.262.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
