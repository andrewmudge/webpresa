# Environment variables for local development
# Copy to .env.local and fill in real values.
# Never commit .env.local to version control.

# -------------------------------------------------------------------
# AWS --- DynamoDB, S3, and Secrets Manager access
# -------------------------------------------------------------------

AWS_REGION=us-east-1

# --- Local development only ---
# AWS SSO profile. The SDK uses this to resolve temporary credentials from the
# SSO session. Not needed (and ignored) in Vercel -- use the access keys below.
AWS_PROFILE=webpresa-dev

# --- Vercel / CI only ---
# Long-lived access keys for the webpresa-vercel-dev IAM user.
# Leave blank locally when using AWS_PROFILE above.
# See deployment.md for how to create the IAM user and policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB table names (from CloudFormation outputs webpresa-dev-*-name)
BUSINESSES_TABLE_NAME=webpresa-dev-businesses
SITE_PREVIEWS_TABLE_NAME=webpresa-dev-site-previews
SCAN_EVENTS_TABLE_NAME=webpresa-dev-scan-events
SCAN_EXECUTIONS_TABLE_NAME=webpresa-dev-scan-executions
POSTCARDS_TABLE_NAME=webpresa-dev-postcards
CLAIMS_TABLE_NAME=webpresa-dev-claims
CUSTOMER_BILLING_PROFILES_TABLE_NAME=webpresa-dev-customer-billing-profiles
CAMPAIGNS_TABLE_NAME=webpresa-dev-campaigns
CAMPAIGN_RECIPIENTS_TABLE_NAME=webpresa-dev-campaign-recipients
SCAN_HITS_TABLE_NAME=webpresa-dev-scan-hits

# S3 assets bucket name (from CloudFormation output webpresa-dev-assets-name)
# Single bucket, prefix-scoped: scans/, previews/, postcards/, businesses/
ASSETS_BUCKET_NAME=webpresa-dev-assets

# Secrets Manager secret names (Stage 10) — the app reads the secret's *name*
# from these env vars, then fetches the JSON value at runtime.
# Real values are populated out-of-band; see architecture.md for JSON shapes.
OPENAI_SECRET_NAME=webpresa-dev-openai
FIRECRAWL_SECRET_NAME=webpresa-dev-firecrawl
GOOGLE_PLACES_SECRET_NAME=webpresa-dev-google-places
STRIPE_SECRET_NAME=webpresa-dev-stripe
LOB_SECRET_NAME=webpresa-dev-lob
INTERNAL_API_SECRET_NAME=webpresa-dev-internal-api
CLAIM_TOKEN_SECRET_NAME=webpresa-dev-claim-token

# Stage 16 — Step Functions scan workflow state machine ARN (from
# CloudFormation output webpresa-dev-scan-workflow-arn). Required for the
# admin "Run full scan" trigger to start an execution.
SCAN_WORKFLOW_STATE_MACHINE_ARN=

# OpenAI model used for Stage 11 website generation. Configurable rather
# than hardcoded — change here (or override per-environment in Vercel)
# without touching application code.
OPENAI_MODEL=gpt-4o-mini

# OpenAI model used for Stage 15 AI website scoring — deliberately separate
# from OPENAI_MODEL above and defaulted to a stronger model, since this
# output drives real sales-prioritization decisions.
OPENAI_SCORING_MODEL=gpt-5.5

# -------------------------------------------------------------------
# Admin authentication
# -------------------------------------------------------------------

# The admin username to accept at sign-in.
ADMIN_USERNAME=admin

# scrypt hash of the admin password --- format: <hex hash>:<hex salt>
# Pure hex output; no special characters, no quoting needed.
# Generate with (run from web/):
#   node -e "const{scryptSync,randomBytes}=require('crypto');const salt=randomBytes(16).toString('hex');console.log(scryptSync('YOUR_PASSWORD',salt,64).toString('hex')+':'+salt)"
ADMIN_PASSWORD_HASH=

# Secret used to sign admin session JWTs.  Must be at least 32 chars.
# Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# -------------------------------------------------------------------
# Customer authentication (Stage 17 — Website Claim Flow)
# -------------------------------------------------------------------

# Cognito User Pool + App Client IDs (from CloudFormation outputs
# webpresa-dev-customers-user-pool-id / -user-pool-client-id). Customer
# identity lives entirely in Cognito — there is no CUSTOMER_ACCOUNTS table.
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=

# Secret used to sign customer session JWTs — separate from SESSION_SECRET
# so an admin session can never verify as a customer session or vice versa.
# Generate with:
#   openssl rand -base64 32
CUSTOMER_SESSION_SECRET=

# Secret used to sign the short-lived claim-attempt cookie — separate again
# from both session secrets. Generate with:
#   openssl rand -base64 32
CLAIM_ATTEMPT_SECRET=

# -------------------------------------------------------------------
# Stripe Subscriptions (Stage 18)
# -------------------------------------------------------------------

# Stripe test-mode Price IDs (Dashboard → Products). NOT secrets, but kept
# server-only (never NEXT_PUBLIC_) so the browser can never submit or
# influence which Price a Checkout Session charges.
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_GROWTH=

# The real deployed app URL — used to build Checkout success/cancel URLs and
# the Customer Portal return URL server-side. Same variable name as the
# existing infra-side (Stage 14/16) shell variable read by `infra/bin/webpresa.ts`
# at CDK synth time; this is the separate `web/` runtime copy.
WEBPRESA_APP_BASE_URL=http://localhost:3000

# A simple version tag for the placeholder terms-of-service/privacy-policy
# copy shown before Checkout — NOT final legal language (Stage 26 owns that).
# Bump this string whenever the placeholder copy changes.
TERMS_VERSION=draft-2026-07

# -------------------------------------------------------------------
# Stage 22 — Webpresa Postcard Generation and Lob Fulfillment
# -------------------------------------------------------------------

POSTCARD_WEBHOOK_EVENTS_TABLE_NAME=webpresa-dev-postcard-webhook-events

# Phase 2 — the render Lambda, invoked synchronously by lib/postcards/render.ts.
POSTCARD_RENDER_LAMBDA_FUNCTION_NAME=webpresa-dev-postcard-render

# Webpresa's own return/sender address — not a secret, printed on every
# outgoing postcard. Read by web/lib/env/lob-sender-address.ts.
WEBPRESA_LOB_SENDER_NAME=
WEBPRESA_LOB_SENDER_ADDRESS_LINE1=
WEBPRESA_LOB_SENDER_ADDRESS_LINE2=
WEBPRESA_LOB_SENDER_CITY=
WEBPRESA_LOB_SENDER_STATE=
WEBPRESA_LOB_SENDER_POSTAL_CODE=
WEBPRESA_LOB_SENDER_COUNTRY=
